{
  "name": "@frappe-harness/fixed-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19 <27"
  },
  "scripts": {
    "dev": "vite",
    "check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:live": "playwright test --config=playwright.live.config.ts",
    "build": "vite build",
    "verify": "npm run check && npm run test && npm run build"
  },
  "dependencies": {
    "vue": "3.5.24"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "24.5.2",
    "@vitejs/plugin-vue": "6.0.1",
    "@vue/test-utils": "2.4.6",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "3.2.7",
    "vue-tsc": "3.0.5"
  }
}
