        {"fieldname": "subject", "fieldtype": "Data", "reqd": true},
        {"fieldname": "project", "fieldtype": "Link", "options": "Commander Probe Project"},
        {"fieldname": "active", "fieldtype": "Check", "default": "1"}
      ],
      "metadata_sha256": "f89d3aa6569edda031185123523f858d4b86947ea8fddad2ccd2e78899c6eef4"
